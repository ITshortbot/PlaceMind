# Environment: development | staging | production
ENVIRONMENT=development

# Database Connection (Neon Serverless PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-host>.neon.tech/placemind?sslmode=require

# Google Gemini API Key (For Cloud SaaS Mode)
# Optional; required only when Gemini is explicitly selected.
GEMINI_API_KEY=

# Local LM Studio Server (For Desktop Local Mode)
LM_STUDIO_API_BASE=http://localhost:1234/v1
LOCAL_MODEL_NAME=openai/local-model

# Cloudflare R2 Object Storage (Optional for Cloud PDF storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=placemind-resumes
R2_PUBLIC_URL_PREFIX=https://cdn.placemind.app

# --- Authentication (Google sign-in) ---
# Google OAuth 2.0 Web client from Google Cloud Console. The secret is set
# here on the host only and is never committed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in the Google console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Session signing key. Generate per deployment: openssl rand -hex 32
AUTH_SECRET_KEY=
# Remembered session lifetime in days (default 14)
AUTH_SESSION_DAYS=14
# Set true when serving over HTTPS
AUTH_COOKIE_SECURE=false
# Public base URL of the frontend (post-login redirects)
FRONTEND_URL=http://localhost:3000
# Guest sessions: creation per IP and guest API operations per user/IP
RATE_LIMIT_GUEST_CREATION_PER_IP=20
RATE_LIMIT_GUEST_CREATION_WINDOW_SECONDS=3600
RATE_LIMIT_GUEST_OPERATIONS_PER_USER=600
RATE_LIMIT_GUEST_OPERATIONS_PER_IP=3000
RATE_LIMIT_GUEST_OPERATIONS_WINDOW_SECONDS=3600
