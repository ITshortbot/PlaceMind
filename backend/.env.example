# Environment: development | staging | production
ENVIRONMENT=development

# Database Connection (Neon Serverless PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-host>.neon.tech/placemind?sslmode=require

# Google Gemini API Key (For Cloud SaaS Mode)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Local LM Studio Server (For Desktop Local Mode)
LM_STUDIO_API_BASE=http://localhost:1234/v1
LOCAL_MODEL_NAME=openai/local-model

# Cloudflare R2 Object Storage (Optional for Cloud PDF storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=placemind-resumes
R2_PUBLIC_URL_PREFIX=https://cdn.placemind.app
